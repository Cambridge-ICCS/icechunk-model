/-!
# Finite maps model

Association lists (finite maps)
which are used as a standin for the `HashMap`/`BTreeMap`s

`insert` conses a new entry that shadows older ones,
so `get?` behaves like the Rust
maps. Everything is computable, so concrete examples can be checked by `decide`/`rfl`.

Some of the following code was generated by Claude Opus 5.5
and then checked / rewritten by Dominic Orchard.

-/

structure Map (K V : Type) where
  entries : List (K × V)
  deriving Repr, DecidableEq

namespace Map

variable {K V : Type} [DecidableEq K]

def empty : Map K V := ⟨[]⟩

def isEmpty (m : Map K V) : Bool := m.entries.isEmpty

instance : EmptyCollection (Map K V) := ⟨empty⟩

def get? (m : Map K V) (k : K) : Option V := m.entries.lookup k

def contains (m : Map K V) (k : K) : Bool := (m.get? k).isSome

def insert (m : Map K V) (k : K) (v : V) : Map K V := ⟨(k, v) :: m.entries⟩

def erase (m : Map K V) (k : K) : Map K V := ⟨m.entries.filter fun e => e.1 ≠ k⟩

/-- `HashMap::extend`: entries of `other` overwrite those of `m`. -/
def extend (m other : Map K V) : Map K V := ⟨other.entries ++ m.entries⟩

def keys (m : Map K V) : List K := (m.entries.map Prod.fst).eraseDups

/-- Build a map from a key list and a lookup function. -/
def ofKeys (ks : List K) (f : K → Option V) : Map K V :=
  ⟨ks.filterMap fun k => (f k).map (k, ·)⟩

/-- Pointwise combination: `f` on keys present in both maps, otherwise whichever is present. -/
def mergeWith (m other : Map K V) (f : V → V → V) : Map K V :=
  ofKeys (other.keys ++ m.keys) fun k =>
    match m.get? k, other.get? k with
    | some a, some b => some (f a b)
    | a, none => a
    | none, b => b

/-! ## Lemmas -/

@[simp] theorem get?_empty (k : K) : (empty : Map K V).get? k = none := rfl

@[simp] theorem get?_emptyc (k : K) : (∅ : Map K V).get? k = none := rfl

@[simp] theorem get?_insert (m : Map K V) (k k' : K) (v : V) :
    (m.insert k v).get? k' = if k = k' then some v else m.get? k' := by
  simp only [get?, insert, List.lookup_cons]
  by_cases h : k = k' <;> simp_all <;> grind

theorem lookup_filter (l : List (K × V)) (k k' : K) :
    (l.filter fun e => e.1 ≠ k).lookup k' = if k = k' then none else l.lookup k' := by
  induction l with
  | nil => simp
  | cons e l ih =>
    obtain ⟨a, b⟩ := e
    by_cases h : a = k <;> simp_all [List.lookup_cons] <;> grind

@[simp] theorem get?_erase (m : Map K V) (k k' : K) :
    (m.erase k).get? k' = if k = k' then none else m.get? k' :=
  lookup_filter m.entries k k'

@[simp] theorem get?_extend (m other : Map K V) (k : K) :
    (m.extend other).get? k = (other.get? k).or (m.get? k) :=
  List.lookup_append

theorem mem_keys (m : Map K V) (k : K) : k ∈ m.keys ↔ (m.get? k).isSome := by
  simp only [keys, List.mem_eraseDups, get?, List.lookup_isSome_iff, List.mem_map, beq_iff_eq]
  grind

@[simp] theorem contains_eq (m : Map K V) (k : K) : m.contains k = (m.get? k).isSome := rfl

theorem lookup_ofKeys (ks : List K) (f : K → Option V) (k : K) :
    (ks.filterMap fun k' => (f k').map (k', ·)).lookup k = if k ∈ ks then f k else none := by
  induction ks with
  | nil => simp
  | cons k₀ ks ih =>
    cases h : f k₀ with
    | none =>
      simp only [List.filterMap_cons, h, Option.map_none, ih, List.mem_cons]
      by_cases hk : k = k₀ <;> simp_all
    | some v =>
      simp only [List.filterMap_cons, h, Option.map_some, List.lookup_cons, ih, List.mem_cons]
      by_cases hk : k = k₀
      · simp_all
      · simp_all [beq_false_of_ne hk]

@[simp] theorem get?_ofKeys (ks : List K) (f : K → Option V) (k : K) :
    (ofKeys ks f).get? k = if k ∈ ks then f k else none :=
  lookup_ofKeys ks f k

theorem get?_mergeWith (m other : Map K V) (f : V → V → V) (k : K) :
    (m.mergeWith other f).get? k =
      match m.get? k, other.get? k with
      | some a, some b => some (f a b)
      | a, none => a
      | none, b => b := by
  simp only [mergeWith, get?_ofKeys, List.mem_append, mem_keys]
  split
  · rfl
  · rename_i h
    cases h₁ : m.get? k <;> cases h₂ : other.get? k <;> simp_all

end Map
